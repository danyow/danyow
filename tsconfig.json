{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "_migration-upstream",
    "migration"
  ]
}
